# Copie este ficheiro para ".env" e preencha os valores.
# Em Cloud Agents, defina estes valores como Secrets (não commite o .env).

# --- Obrigatórios para o bot ligar ao Discord ---
# Token do bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information). Aceita CLIENT_ID ou DISCORD_CLIENT_ID.
CLIENT_ID=

# --- Recomendados ---
# ID do servidor: regista os slash commands instantaneamente nesse servidor.
# Sem isto, os comandos são globais e podem demorar até 1h a aparecer.
GUILD_ID=
# Canal de logs do bot.
LOG_CHANNEL_ID=
# Canal onde caem os pedidos/compras (usa LOG_CHANNEL_ID se não definido).
PEDIDOS_CHANNEL_ID=

# --- Opcionais ---
# Texto com as instruções de pagamento manual mostrado ao cliente.
PAYMENT_INFO=
# Banners (URLs http/https) usados nos painéis.
LOJA_BANNER_URL=
TICKETS_BANNER_URL=
VERIFY_BANNER_URL=
# Tickets: categoria onde os canais são criados e cargo da staff.
TICKETS_CATEGORIA_ID=
TICKETS_CARGO_STAFF_ID=
# Cargo dado na verificação.
VERIFY_ROLE_ID=
# Caminho da base de dados SQLite (por omissão: loja.db no diretório do projeto).
# Útil para apontar a um volume persistente. Ex.: /data/loja.db
DATABASE_PATH=
# Moeda usada pelo "npm run seed" (por omissão: brl). Ex.: eur, usd.
SEED_CURRENCY=
